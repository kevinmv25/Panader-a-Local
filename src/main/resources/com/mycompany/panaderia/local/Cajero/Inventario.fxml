<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="760.0" prefWidth="1200.0" style="-fx-background-color: #F4CC79;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.panaderia.local.Controllers.InventarioController">

    <VBox prefHeight="760.0" prefWidth="1200.0" spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- ENCABEZADO -->
        <HBox alignment="CENTER_LEFT" minHeight="105.0" prefHeight="105.0" spacing="30.0" style="-fx-background-color: #FFF8EC;">

            <padding>
                <Insets bottom="0.0" left="55.0" right="55.0" top="0.0" />
            </padding>

            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label style="-fx-font-family: 'Georgia'; -fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #422817;" text="El Lirio Rojo" />
                <Label style="-fx-font-size: 10px; -fx-text-fill: #6B4A2E;" text="PANADERÍA ARTESANAL" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="32.0">

                <Button fx:id="btnRegresar" style="-fx-background-color: #422817;                                -fx-text-fill: #FFF8EC;                                -fx-font-weight: bold;                                -fx-background-radius: 8;                                -fx-padding: 10 18;" text="Regresar" />
            </HBox>
        </HBox>

        <!-- PANEL DE INVENTARIO -->
        <VBox spacing="22.0" style="-fx-background-color: #FFF8EC; -fx-background-radius: 22px; -fx-border-color: #E9BD6B; -fx-border-radius: 22px; -fx-border-width: 1px;" VBox.vgrow="ALWAYS">

            <VBox.margin>
                <Insets bottom="35.0" left="36.0" right="36.0" top="32.0" />
            </VBox.margin>

            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="24.0" />
            </padding>

            <!-- BUSCADOR -->
            <HBox alignment="CENTER_RIGHT" minHeight="54.0">
                <HBox alignment="CENTER_LEFT" minHeight="46.0" prefWidth="300.0" spacing="10.0" style="-fx-background-color: #FFF8EC; -fx-background-radius: 22px; -fx-border-color: #E9BD6B; -fx-border-radius: 22px;">

                    <padding>
                        <Insets left="14.0" right="14.0" />
                    </padding>

                    <Label style="-fx-font-size: 27px; -fx-text-fill: #422817;" text="⌕" />

                    <TextField fx:id="txtBuscarMaterial" onAction="#buscarMaterial" promptText="Buscar material..." style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #422817; -fx-prompt-text-fill: #9B8468;" HBox.hgrow="ALWAYS" />
                </HBox>
            </HBox>

            <!-- TABLA -->
            <TableView fx:id="tablaMateriales" prefHeight="500.0" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colNombreMaterial" minWidth="180.0" prefWidth="480.0" text="Material" />

                    <TableColumn fx:id="colUnidad" minWidth="100.0" prefWidth="280.0" text="Unidad" />

                    <TableColumn fx:id="colExistencia" minWidth="120.0" prefWidth="240.0" text="Stock actual" />
                </columns>

                <placeholder>
                    <Label style="-fx-text-fill: #6B4A2E; -fx-font-size: 15px;" text="No se encontraron materiales." />
                </placeholder>
            </TableView>
        </VBox>
    </VBox>
</AnchorPane>
