<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.panaderia.local.Controllers.InventarioController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="235.0" spacing="12.0" style="-fx-background-color: #1D1B1A;">

            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="22.0" />
            </padding>

            <!-- IDENTIDAD -->
            <VBox spacing="5.0">

                <Label style="-fx-text-fill: white;                            -fx-font-size: 21px;                            -fx-font-weight: bold;" text="EL LIRIO ROJO" />

                <Label style="-fx-text-fill: #F39817;                            -fx-font-size: 12px;" text="Panel de Administrador" />
            </VBox>

            <Separator />

            <!-- OPCIONES DEL MENÚ -->
            <Button maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent;                        -fx-text-fill: white;                        -fx-font-weight: bold;" text="Inicio" />

            <Button maxWidth="Infinity" prefHeight="50.0" style="-fx-background-color: transparent;                        -fx-text-fill: white;                        -fx-font-weight: bold;" text="Catálogo de Panes" />

            <Button maxWidth="Infinity" prefHeight="50.0" style="-fx-background-color: transparent;                        -fx-text-fill: white;                        -fx-font-weight: bold;" text="Producción" />

            <!-- OPCIÓN SELECCIONADA -->
            <Button maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: #E68000;                        -fx-text-fill: white;                        -fx-font-weight: bold;                        -fx-background-radius: 9;" text="Materiales" />

            <Button maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent;                        -fx-text-fill: white;                        -fx-font-weight: bold;" text="Ventas" />

            <Button maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent;                        -fx-text-fill: white;                        -fx-font-weight: bold;" text="Pedidos" />

            <Region VBox.vgrow="ALWAYS" />

            <Separator />

            <!-- CERRAR SESIÓN -->
            <Button maxWidth="Infinity" prefHeight="42.0" style="-fx-background-color: #383331;                        -fx-text-fill: white;                        -fx-background-radius: 8;" text="Cerrar Sesión" />

        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <AnchorPane style="-fx-background-color: #FFFFFF;">

            <!-- ENCABEZADO -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="0.0">

                <Label style="-fx-font-family: 'Georgia';                            -fx-font-size: 30px;                            -fx-font-weight: bold;                            -fx-text-fill: #000000;" text="Inventario de materiales" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="btnRegresar" style="-fx-background-color: #383331;                            -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 8;                            -fx-padding: 10 18;" text="Regresar" />

                <Label style="-fx-text-fill: #D77700;                            -fx-background-color: #FFF3E0;                            -fx-padding: 10 14 10 14;                            -fx-background-radius: 7;                            -fx-font-size: 12px;" text="HOLA ADMINISTRADOR" />
            <opaqueInsets>
               <Insets />
            </opaqueInsets>
            <padding>
               <Insets top="20.0" />
            </padding>
            </HBox>

            <!-- PANEL DE INVENTARIO -->
            <VBox spacing="22.0" style="-fx-background-color: #F7F7F7;                        -fx-background-radius: 3;" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="100.0">

                <padding>
                    <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                </padding>

                <!-- BUSCADOR -->
                <HBox alignment="CENTER_RIGHT" minHeight="54.0">

                    <HBox alignment="CENTER_LEFT" minHeight="42.0" prefWidth="320.0" spacing="10.0" style="-fx-background-color: #FFFFFF;                                -fx-background-radius: 8;                                -fx-border-color: #E5E5E5;                                -fx-border-radius: 8;">

                        <padding>
                            <Insets left="14.0" right="14.0" />
                        </padding>

                        <Label style="-fx-font-size: 25px;                                    -fx-text-fill: #77716D;" text="⌕" />

                        <TextField fx:id="txtBuscarMaterial" onAction="#buscarMaterial" promptText="Buscar material..." style="-fx-background-color: transparent;                                    -fx-border-color: transparent;                                    -fx-text-fill: #1D1B1A;                                    -fx-prompt-text-fill: #999999;                                    -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                    </HBox>
                </HBox>

                <!-- TABLA DE MATERIALES -->
                <TableView fx:id="tablaMateriales" prefHeight="500.0" style="-fx-background-color: #FFFFFF;                            -fx-border-color: #E5E5E5;                            -fx-border-radius: 5;                            -fx-background-radius: 5;" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colNombreMaterial" minWidth="180.0" prefWidth="480.0" text="Material" />

                        <TableColumn fx:id="colUnidad" minWidth="100.0" prefWidth="280.0" text="Unidad" />

                        <TableColumn fx:id="colExistencia" minWidth="120.0" prefWidth="240.0" text="Stock actual" />

                    </columns>

                    <placeholder>
                        <Label style="-fx-text-fill: #77716D;                                    -fx-font-size: 15px;" text="No se encontraron materiales." />
                    </placeholder>

                </TableView>

            </VBox>

        </AnchorPane>
    </center>

</BorderPane>
