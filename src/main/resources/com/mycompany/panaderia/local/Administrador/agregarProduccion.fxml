<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    minHeight="560.0"
    minWidth="900.0"
    prefHeight="675.0"
    prefWidth="1200.0"
    style="-fx-background-color: #F7F7F7;"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.mycompany.panaderia.local.Controllers.AdminController.AgregarProduccionController">

    <!-- SIDEBAR -->
    <VBox
        prefWidth="218.0"
        minWidth="218.0"
        spacing="0.0"
        style="-fx-background-color: #1D1B1A;"
        AnchorPane.topAnchor="0.0"
        AnchorPane.bottomAnchor="0.0"
        AnchorPane.leftAnchor="0.0">

        <VBox spacing="3.0" style="-fx-padding: 24 12 20 12;">
            <Label
                text="EL LIRIO ROJO"
                style="-fx-font-family: 'Manrope'; -fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label
                text="Panel de Administrador"
                style="-fx-font-family: 'Manrope'; -fx-font-size: 11px; -fx-text-fill: #E68000;"/>

            <Region minHeight="12.0"/>

            <Region
                prefHeight="2.0"
                minHeight="2.0"
                style="-fx-background-color: #77716D;"/>
        </VBox>

        <VBox spacing="8.0" style="-fx-padding: 0 12 0 12;">

            <Button
                text="Inicio"
                maxWidth="Infinity"
                prefHeight="43.0"
                style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white; -fx-cursor: hand;"/>

            <Button
                text="Catálogo de Panes"
                onAction="#abrirCatalogo"
                maxWidth="Infinity"
                prefHeight="43.0"
                style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white; -fx-cursor: hand;"/>

            <Button
                text="Producción"
                onAction="#volverProduccion"
                maxWidth="Infinity"
                prefHeight="43.0"
                style="-fx-background-color: #E68000; -fx-background-radius: 8; -fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white; -fx-cursor: hand;"/>

            <Button
                text="Materiales"
                maxWidth="Infinity"
                prefHeight="43.0"
                style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white; -fx-cursor: hand;"/>

            <Button
                text="Ventas"
                maxWidth="Infinity"
                prefHeight="43.0"
                style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white; -fx-cursor: hand;"/>

            <Button
                text="Pedidos"
                maxWidth="Infinity"
                prefHeight="43.0"
                style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white; -fx-cursor: hand;"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox spacing="12.0" style="-fx-padding: 12;">
            <Region
                prefHeight="2.0"
                minHeight="2.0"
                style="-fx-background-color: #77716D;"/>

            <Button
                text="Cerrar Sesión"
                maxWidth="Infinity"
                prefHeight="42.0"
                style="-fx-background-color: #373330; -fx-background-radius: 8; -fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-text-fill: white; -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <!-- CONTENIDO PRINCIPAL -->
    <AnchorPane
        style="-fx-background-color: #F7F7F7;"
        AnchorPane.leftAnchor="218.0"
        AnchorPane.rightAnchor="0.0"
        AnchorPane.topAnchor="0.0"
        AnchorPane.bottomAnchor="0.0">

        <!-- ENCABEZADO -->
        <HBox
            alignment="CENTER_LEFT"
            spacing="12.0"
            prefHeight="76.0"
            style="-fx-background-color: white; -fx-border-color: #EAEAEA; -fx-border-width: 0 0 1 0; -fx-padding: 0 28 0 28;"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0">

            <Label
                text="El Lirio Rojo"
                style="-fx-font-family: 'Fraunces'; -fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #1D1B1A;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label
                text="HOLA ADMINISTRADOR"
                style="-fx-background-color: #FFF3E0; -fx-background-radius: 8; -fx-padding: 11 14 11 14; -fx-font-family: 'Manrope'; -fx-font-size: 11px; -fx-text-fill: #B96A00;"/>
        </HBox>

        <!-- ÁREA DEL FORMULARIO -->
        <VBox
            spacing="25.0"
            style="-fx-padding: 30 34 30 34;"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="76.0"
            AnchorPane.bottomAnchor="0.0">

            <!-- TÍTULO -->
            <HBox alignment="CENTER_LEFT" spacing="13.0">
                <Button
                    text="←"
                    onAction="#volverProduccion"
                    prefWidth="38.0"
                    prefHeight="38.0"
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E5E5; -fx-border-radius: 8; -fx-font-size: 22px; -fx-text-fill: #1D1B1A; -fx-cursor: hand;"/>

                <VBox spacing="4.0">
                    <Label
                        text="Registrar producción"
                        style="-fx-font-family: 'Fraunces'; -fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #1D1B1A;"/>

                    <Label
                        text="Registra la cantidad de pan elaborada y su fecha."
                        style="-fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-text-fill: #77716D;"/>
                </VBox>
            </HBox>

            <!-- FORMULARIO -->
            <VBox
                spacing="26.0"
                maxWidth="850.0"
                style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #EAEAEA; -fx-border-radius: 12; -fx-padding: 28;">

                <HBox spacing="28.0" alignment="TOP_LEFT">

                    <VBox spacing="9.0" HBox.hgrow="ALWAYS">
                        <Label
                            text="Tipo de pan"
                            style="-fx-font-family: 'Manrope'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #37302B;"/>

                        <ComboBox
                            fx:id="cmbTipoPan"
                            maxWidth="Infinity"
                            prefHeight="40.0"
                            promptText="Selecciona un pan"
                            style="-fx-background-color: white; -fx-border-color: #E5E5E5; -fx-border-radius: 7; -fx-background-radius: 7; -fx-font-family: 'Manrope'; -fx-font-size: 12px;"/>
                    </VBox>

                    <VBox spacing="9.0" HBox.hgrow="ALWAYS">
                        <Label
                            text="Cantidad"
                            style="-fx-font-family: 'Manrope'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #37302B;"/>

                        <TextField
                            fx:id="txtCantidad"
                            prefHeight="40.0"
                            maxWidth="Infinity"
                            promptText="Ingresa la cantidad producida"
                            style="-fx-background-color: white; -fx-border-color: #E5E5E5; -fx-border-radius: 7; -fx-background-radius: 7; -fx-font-family: 'Manrope'; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>

                <VBox spacing="9.0" maxWidth="390.0">
                    <Label
                        text="Fecha de producción"
                        style="-fx-font-family: 'Manrope'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #37302B;"/>

                    <DatePicker
                        fx:id="dpFecha"
                        maxWidth="Infinity"
                        prefHeight="40.0"
                        promptText="Selecciona la fecha"
                        style="-fx-background-color: white; -fx-border-color: #E5E5E5; -fx-border-radius: 7; -fx-background-radius: 7; -fx-font-family: 'Manrope'; -fx-font-size: 12px;"/>
                </VBox>

            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- BOTONES -->
            <HBox
                alignment="CENTER_RIGHT"
                spacing="14.0">

                <Button
                    fx:id="btnCancelar"
                    text="Cancelar"
                    onAction="#cancelar"
                    prefWidth="135.0"
                    prefHeight="42.0"
                    style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #D8D4D0; -fx-border-radius: 8; -fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37302B; -fx-cursor: hand;"/>

                <Button
                    fx:id="btnGuardar"
                    text="Guardar producción"
                    onAction="#guardarProduccion"
                    prefWidth="195.0"
                    prefHeight="42.0"
                    style="-fx-background-color: #E68000; -fx-background-radius: 8; -fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </AnchorPane>
</AnchorPane>

