<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.panaderia.local.Controllers.AdminController.ProduccionDiariaController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="235.0" spacing="12.0" style="-fx-background-color: #1D1B1A;">

            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="22.0" />
            </padding>

            <VBox spacing="5.0">
                <Label style="-fx-text-fill: white;                               -fx-font-size: 21px;                               -fx-font-weight: bold;" text="EL LIRIO ROJO" />

                <Label style="-fx-text-fill: #F39817;                               -fx-font-size: 12px;" text="Panel de Administrador" />
            </VBox>

            <Separator />

            <Button maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent;                            -fx-text-fill: white;                            -fx-font-weight: bold;" text="Inicio" />

            <Button maxWidth="Infinity" onAction="#abrirCatalogo" prefHeight="50.0" style="-fx-background-color: transparent;                            -fx-text-fill: white;                            -fx-font-weight: bold;" text="Catálogo de Panes" />

            <!-- Opción seleccionada -->
            <Button maxWidth="Infinity" prefHeight="50.0" style="-fx-background-color: #E68000;                            -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 9;" text="Producción" />

            <Button maxWidth="Infinity" onAction="#abrirMenuMateriales" prefHeight="45.0" style="-fx-background-color: transparent;                            -fx-text-fill: white;                            -fx-font-weight: bold;" text="Materiales" />

            <Button maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent;                            -fx-text-fill: white;                            -fx-font-weight: bold;" text="Ventas" />

            <Button maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent;                            -fx-text-fill: white;                            -fx-font-weight: bold;" text="Pedidos" />

            <Region VBox.vgrow="ALWAYS" />

            <Separator />

            <Button maxWidth="Infinity" prefHeight="42.0" style="-fx-background-color: #383331;                            -fx-text-fill: white;                            -fx-background-radius: 8;" text="Cerrar Sesión" />

        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <AnchorPane style="-fx-background-color: #FFFFFF;">

            <!-- Encabezado -->
            <Label layoutX="30.0" layoutY="25.0" style="-fx-font-family: 'Georgia';                           -fx-font-size: 30px;                           -fx-font-weight: bold;                           -fx-text-fill: #000000;" text="El Lirio Rojo" />

            <Label style="-fx-text-fill: #D77700;                           -fx-background-color: #FFF3E0;                           -fx-padding: 10 14 10 14;                           -fx-background-radius: 7;                           -fx-font-size: 12px;" text="HOLA ADMINISTRADOR" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="21.0" />

            <!-- TARJETAS -->
            <HBox alignment="CENTER" spacing="24.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="260.0">

                <padding>
                    <Insets bottom="0.0" top="0.0" />
                </padding>

                <!-- Registrar producción -->
                <Button fx:id="btnRegistrar" maxWidth="Infinity" minWidth="0.0" onAction="#abrirRegistro" prefHeight="170.0" style="-fx-background-color: #F0EEEE;                                -fx-background-radius: 2;                                -fx-border-color: transparent;                                -fx-text-fill: #000000;                                -fx-font-family: 'Georgia';                                -fx-font-size: 22px;                                -fx-font-weight: bold;                                -fx-alignment: CENTER;                                -fx-text-alignment: CENTER;                                -fx-cursor: hand;" text="Registrar producción" wrapText="true" HBox.hgrow="ALWAYS" />

                <!-- Ver resumen del día -->
                <Button fx:id="btnResumen" maxWidth="Infinity" minWidth="0.0" onAction="#abrirResumen" prefHeight="170.0" style="-fx-background-color: #F0EEEE;                                -fx-background-radius: 2;                                -fx-border-color: transparent;                                -fx-text-fill: #000000;                                -fx-font-family: 'Georgia';                                -fx-font-size: 22px;                                -fx-font-weight: bold;                                -fx-alignment: CENTER;                                -fx-text-alignment: CENTER;                                -fx-cursor: hand;" text="Ver resumen&#10;del día" wrapText="true" HBox.hgrow="ALWAYS" />

                <!-- Tabla de producción -->
                <Button fx:id="btnHistorial" maxWidth="Infinity" minWidth="0.0" onAction="#abrirHistorial" prefHeight="170.0" style="-fx-background-color: #F0EEEE;                                -fx-background-radius: 2;                                -fx-border-color: transparent;                                -fx-text-fill: #000000;                                -fx-font-family: 'Georgia';                                -fx-font-size: 22px;                                -fx-font-weight: bold;                                -fx-alignment: CENTER;                                -fx-text-alignment: CENTER;                                -fx-cursor: hand;" text="Tabla de producción" wrapText="true" HBox.hgrow="ALWAYS" />

            </HBox>

        </AnchorPane>
    </center>

</BorderPane>
