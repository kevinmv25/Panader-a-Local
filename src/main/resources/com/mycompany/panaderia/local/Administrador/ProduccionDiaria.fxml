<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0"
            prefWidth="1280.0"
            style="-fx-background-color: #FFFFFF;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.panaderia.local.Controllers.AdminController.ProduccionDiariaController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="235.0"
              spacing="12.0"
              style="-fx-background-color: #1D1B1A;">

            <padding>
                <Insets top="22.0" left="15.0" right="15.0" bottom="20.0"/>
            </padding>

            <VBox spacing="5.0">
                <Label text="EL LIRIO ROJO"
                       style="-fx-text-fill: white;
                              -fx-font-size: 21px;
                              -fx-font-weight: bold;"/>

                <Label text="Panel de Administrador"
                       style="-fx-text-fill: #F39817;
                              -fx-font-size: 12px;"/>
            </VBox>

            <Separator/>

            <Button text="Inicio"
                    maxWidth="Infinity"
                    prefHeight="45.0"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>

            <Button text="Catálogo de Panes"
                    onAction="#abrirCatalogo"
                    maxWidth="Infinity"
                    prefHeight="50.0"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>

            <!-- Opción seleccionada -->
            <Button text="Producción"
                    maxWidth="Infinity"
                    prefHeight="50.0"
                    style="-fx-background-color: #E68000;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 9;"/>

            <Button text="Materiales"
                    maxWidth="Infinity"
                    prefHeight="45.0"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>

            <Button text="Ventas"
                    maxWidth="Infinity"
                    prefHeight="45.0"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>

            <Button text="Pedidos"
                    maxWidth="Infinity"
                    prefHeight="45.0"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator/>

            <Button text="Cerrar Sesión"
                    maxWidth="Infinity"
                    prefHeight="42.0"
                    style="-fx-background-color: #383331;
                           -fx-text-fill: white;
                           -fx-background-radius: 8;"/>

        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <AnchorPane style="-fx-background-color: #FFFFFF;">

            <!-- Encabezado -->
            <Label text="El Lirio Rojo"
                   layoutX="30.0"
                   layoutY="25.0"
                   style="-fx-font-family: 'Georgia';
                          -fx-font-size: 30px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #000000;"/>

            <Label text="HOLA ADMINISTRADOR"
                   AnchorPane.topAnchor="21.0"
                   AnchorPane.rightAnchor="25.0"
                   style="-fx-text-fill: #D77700;
                          -fx-background-color: #FFF3E0;
                          -fx-padding: 10 14 10 14;
                          -fx-background-radius: 7;
                          -fx-font-size: 12px;"/>

            <!-- TARJETAS -->
            <HBox alignment="CENTER"
                  spacing="24.0"
                  AnchorPane.leftAnchor="25.0"
                  AnchorPane.rightAnchor="25.0"
                  AnchorPane.topAnchor="260.0">

                <padding>
                    <Insets top="0.0" bottom="0.0"/>
                </padding>

                <!-- Registrar producción -->
                <Button fx:id="btnRegistrar"
                        onAction="#abrirRegistro"
                        text="Registrar producción"
                        wrapText="true"
                        maxWidth="Infinity"
                        minWidth="0.0"
                        prefHeight="170.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #F0EEEE;
                               -fx-background-radius: 2;
                               -fx-border-color: transparent;
                               -fx-text-fill: #000000;
                               -fx-font-family: 'Georgia';
                               -fx-font-size: 22px;
                               -fx-font-weight: bold;
                               -fx-alignment: CENTER;
                               -fx-text-alignment: CENTER;
                               -fx-cursor: hand;"/>

                <!-- Ver resumen del día -->
                <Button fx:id="btnResumen"
                        onAction="#abrirResumen"
                        text="Ver resumen&#10;del día"
                        wrapText="true"
                        maxWidth="Infinity"
                        minWidth="0.0"
                        prefHeight="170.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #F0EEEE;
                               -fx-background-radius: 2;
                               -fx-border-color: transparent;
                               -fx-text-fill: #000000;
                               -fx-font-family: 'Georgia';
                               -fx-font-size: 22px;
                               -fx-font-weight: bold;
                               -fx-alignment: CENTER;
                               -fx-text-alignment: CENTER;
                               -fx-cursor: hand;"/>

                <!-- Tabla de producción -->
                <Button fx:id="btnHistorial"
                        onAction="#abrirHistorial"
                        text="Tabla de producción"
                        wrapText="true"
                        maxWidth="Infinity"
                        minWidth="0.0"
                        prefHeight="170.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #F0EEEE;
                               -fx-background-radius: 2;
                               -fx-border-color: transparent;
                               -fx-text-fill: #000000;
                               -fx-font-family: 'Georgia';
                               -fx-font-size: 22px;
                               -fx-font-weight: bold;
                               -fx-alignment: CENTER;
                               -fx-text-alignment: CENTER;
                               -fx-cursor: hand;"/>

            </HBox>

        </AnchorPane>
    </center>

</BorderPane>
