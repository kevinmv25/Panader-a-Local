<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="450.0" minWidth="700.0" prefHeight="460.0" prefWidth="940.0" style="-fx-background-color: #FFF8EC;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.panaderia.local.Controllers.AdminController.HistorialProduccionController">

    <HBox alignment="CENTER_LEFT" prefHeight="56.0" spacing="10.0" style="-fx-background-color: #FFF8EC; -fx-border-color: #F8E5C1; -fx-border-width: 0 0 1 0;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="3.0" left="40.0" right="14.0" top="3.0" />
        </padding>
        <ImageView fx:id="imgLogo" fitHeight="52.0" fitWidth="55.0" preserveRatio="true">
         <image>
            <Image url="@../iconos/logo_el_lirio_rojo_hd.png" />
         </image></ImageView>
        <Region HBox.hgrow="ALWAYS" />
        <Label style="-fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6B4A2E;" text="Administrador" />
        <ImageView fx:id="imgAdministrador" fitHeight="30.0" fitWidth="30.0" preserveRatio="true">
         <image>
            <Image url="@../iconos/usuario_16x16.png" />
         </image></ImageView>
    </HBox>

    <VBox maxWidth="159.0" minWidth="159.0" prefWidth="159.0" spacing="0.0" style="-fx-background-color: #FFF8EC; -fx-border-color: #F8E5C1; -fx-border-width: 0 1 0 0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="56.0">

        <Region minHeight="28.0" VBox.vgrow="ALWAYS" />

        <HBox alignment="CENTER_LEFT" prefHeight="42.0" spacing="7.0" style="-fx-padding: 0 7 0 7;">
            <ImageView fx:id="imgInicio" fitHeight="19.0" fitWidth="19.0" preserveRatio="true">
            <image>
               <Image url="@../iconos/hogar_16x16.png" />
            </image></ImageView>
            <Button alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-text-fill: #6B4A2E; -fx-padding: 5 0 5 0;" text="Inicio" HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_LEFT" prefHeight="51.0" spacing="7.0" style="-fx-padding: 0 7 0 7;">
            <ImageView fx:id="imgMateriales" fitHeight="19.0" fitWidth="19.0" preserveRatio="true">
            <image>
               <Image url="@../iconos/materiales_16x16.png" />
            </image></ImageView>
            <Button alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-text-fill: #6B4A2E; -fx-padding: 5 0 5 0;" text="Materiales" HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_LEFT" prefHeight="51.0" spacing="7.0" style="-fx-padding: 0 7 0 7;">
            <ImageView fx:id="imgProductos" fitHeight="19.0" fitWidth="19.0" preserveRatio="true">
            <image>
               <Image url="@../iconos/pan_16x16.png" />
            </image></ImageView>
            <Button alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-text-fill: #6B4A2E; -fx-padding: 5 0 5 0;" text="Productos" HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_LEFT" prefHeight="51.0" spacing="7.0" style="-fx-padding: 0 7 0 7;">
            <ImageView fx:id="imgVentas" fitHeight="19.0" fitWidth="19.0" preserveRatio="true">
            <image>
               <Image url="@../iconos/carrito_compras_16x16.png" />
            </image></ImageView>
            <Button alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-text-fill: #6B4A2E; -fx-padding: 5 0 5 0;" text="Ventas" HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_LEFT" prefHeight="32.0" spacing="7.0" style="-fx-background-color: #FFE7AD; -fx-background-radius: 5; -fx-padding: 0 7 0 7;">
            <ImageView fx:id="imgProduccion" fitHeight="19.0" fitWidth="19.0" preserveRatio="true">
            <image>
               <Image url="@../iconos/estadistica_16x16.png" />
            </image></ImageView>
            <Button alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-font-family: 'Manrope'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #422817; -fx-padding: 5 0 5 0;" text="Producción diaria" HBox.hgrow="ALWAYS" />
        </HBox>

        <Region VBox.vgrow="ALWAYS" />
    </VBox>

    <AnchorPane style="-fx-background-color: #FFF8EC;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="159.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="56.0">

        <HBox alignment="CENTER_LEFT" spacing="9.0" AnchorPane.leftAnchor="9.0" AnchorPane.topAnchor="20.0">
            <ImageView fx:id="imgRegresar" fitHeight="27.0" fitWidth="27.0" preserveRatio="true" />
            <Label style="-fx-font-family: 'Fraunces'; -fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #6B4A2E;" text="Historial de producción" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="8.0" AnchorPane.leftAnchor="80.0" AnchorPane.rightAnchor="45.0" AnchorPane.topAnchor="70.0">

            <Label style="-fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #422817;" text="Desde" />

            <DatePicker fx:id="dpDesde" editable="true" minWidth="110.0" prefWidth="190.0" promptText="Fecha inicial" style="-fx-background-color: #FFFFFF; -fx-border-color: #F8E5C1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-family: 'Manrope'; -fx-font-size: 12px;" HBox.hgrow="ALWAYS" />

            <Region minWidth="5.0" HBox.hgrow="ALWAYS" />

            <Label style="-fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #422817;" text="Hasta" />

            <DatePicker fx:id="dpHasta" editable="true" minWidth="110.0" prefWidth="190.0" promptText="Fecha final" style="-fx-background-color: #FFFFFF; -fx-border-color: #F8E5C1; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-family: 'Manrope'; -fx-font-size: 12px;" HBox.hgrow="ALWAYS" />

            <Button fx:id="btnAplicar" minWidth="75.0" prefHeight="29.0" prefWidth="90.0" style="-fx-background-color: #FFE7AD; -fx-background-radius: 5; -fx-font-family: 'Manrope'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6B4A2E;" text="Aplicar" />

        </HBox>

        <TableView fx:id="tablaHistorial" style="-fx-background-color: #FFFFFF; -fx-border-color: #F8E5C1; -fx-background-radius: 6; -fx-border-radius: 6;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="9.0" AnchorPane.rightAnchor="9.0" AnchorPane.topAnchor="110.0">

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>

            <columns>
                <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha" />
                <TableColumn fx:id="colProducidos" prefWidth="140.0" text="Producidos" />
                <TableColumn fx:id="colVendidos" prefWidth="140.0" text="Vendidos" />
                <TableColumn fx:id="colSobrante" prefWidth="140.0" text="Sobrante" />
                <TableColumn fx:id="colMerma" prefWidth="120.0" text="Merma" />
            </columns>

        </TableView>

    </AnchorPane>

</AnchorPane>
