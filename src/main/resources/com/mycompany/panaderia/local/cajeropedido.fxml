
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.panaderia.local.CajeroController"
            prefWidth="1280.0"
            prefHeight="720.0"
            style="-fx-background-color: #F5D081;">

    <!-- BARRA SUPERIOR -->

    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="85.0"
              spacing="20.0"
              style="-fx-background-color: #422817;">

            <padding>
                <Insets top="12.0"
                        bottom="12.0"
                        left="25.0"
                        right="25.0"/>
            </padding>

            <children>

                <VBox spacing="2.0">
                    <children>

                        <Label text="El Lirio Rojo"
                               style="-fx-font-family: Georgia;
                                      -fx-font-size: 29px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: white;"/>

                        <Label text="P A N A D E R I A   A R T E S A N A L"
                               style="-fx-font-size: 9px;
                                      -fx-text-fill: #F5D081;"/>

                    </children>
                </VBox>

                <Separator orientation="VERTICAL"
                           prefHeight="60.0"/>

                <Label text="PANES"
                       style="-fx-font-family: Georgia;
                              -fx-font-size: 27px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Cajero"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: white;"/>

                <Button fx:id="btnSalir"
                        text="Salir"
                        prefWidth="95.0"
                        prefHeight="40.0"
                        style="-fx-background-color: #FFF8EC;
                               -fx-text-fill: #422817;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;"/>

            </children>
        </HBox>
    </top>

    <!-- CONTENIDO PRINCIPAL -->

    <center>
        <HBox spacing="10.0"
              style="-fx-background-color: #F5D081;">

            <padding>
                <Insets top="12.0"
                        bottom="12.0"
                        left="12.0"
                        right="12.0"/>
            </padding>

            <children>

                <!-- MENU LATERAL -->

                <VBox prefWidth="200.0"
                      minWidth="200.0"
                      spacing="12.0"
                      style="-fx-background-color: #FFF8EC;
                             -fx-background-radius: 15;
                             -fx-padding: 12;">

                    <children>

                        <Button onAction="#abrirGestionPedidos" text="Pedidos y adelantos"
                                prefWidth="175.0"
                                prefHeight="42.0"
                                style="-fx-background-color: #F9E4BE;
                                       -fx-text-fill: #422817;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 12;"/>

                        <Button fx:id="btnIrRegistro"
                                text="Registrar Pedido"
                                prefWidth="175.0"
                                prefHeight="42.0"
                                style="-fx-background-color: #FFE5AA;
                                       -fx-text-fill: #422817;
                                       -fx-font-weight: bold;
                                       -fx-border-color: #F0B858;
                                       -fx-border-radius: 12;
                                       -fx-background-radius: 12;"/>

                        <Button fx:id="btnEditarPedido"
                                text="Editar pedido"
                                prefWidth="175.0"
                                prefHeight="42.0"
                                style="-fx-background-color: #F9E4BE;
                                       -fx-text-fill: #422817;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 12;"/>

                    </children>
                </VBox>

                <!-- CATALOGO CENTRAL -->

                <VBox spacing="15.0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #FFF8EC;
                             -fx-background-radius: 15;
                             -fx-padding: 12;">

                    <children>

                        <!-- BUSCADOR -->

                        <TextField fx:id="txtBuscarProducto"
                                   promptText="Buscar producto..."
                                   prefHeight="35.0"
                                   maxWidth="Infinity"
                                   style="-fx-background-color: white;
                                          -fx-border-color: #E9BD6B;
                                          -fx-border-radius: 10;
                                          -fx-background-radius: 10;
                                          -fx-padding: 8;"/>

                        <!-- AREA DE PANES -->

                        <ScrollPane fitToWidth="true"
                                    hbarPolicy="NEVER"
                                    VBox.vgrow="ALWAYS"
                                    style="-fx-background: #FFF8EC;
                                           -fx-background-color: transparent;
                                           -fx-border-color: transparent;">

                            <content>

                                <FlowPane fx:id="contenedorPanes"
                                          alignment="TOP_LEFT"
                                          hgap="15.0"
                                          vgap="15.0"
                                          prefWrapLength="510.0"
                                          style="-fx-background-color: #FFF8EC;">

                                    <padding>
                                        <Insets top="5.0"
                                                bottom="15.0"
                                                left="5.0"
                                                right="5.0"/>
                                    </padding>

                                    <children>

                                        <!--
                                            UNICA TARJETA DE EJEMPLO
                                            PARA SCENE BUILDER
                                        -->

                                        <VBox alignment="CENTER"
                                              spacing="8.0"
                                              prefWidth="150.0"
                                              prefHeight="190.0"
                                              style="-fx-background-color: white;
                                                     -fx-background-radius: 12;
                                                     -fx-border-color: #E9BD6B;
                                                     -fx-border-radius: 12;
                                                     -fx-padding: 8;">

                                            <children>

                                                <!-- IMAGEN DEL PAN -->

                                                <ImageView fitWidth="110.0"
                                                           fitHeight="75.0"
                                                           preserveRatio="true">

                                                    <image>
                                                        <Image url="@../../../../images/Bolillo.png"/>
                                                    </image>

                                                </ImageView>

                                                <!-- NOMBRE -->

                                                <Label text="Bolillo"
                                                       alignment="CENTER"
                                                       wrapText="true"
                                                       style="-fx-font-family: Georgia;
                                                              -fx-font-size: 13px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #422817;"/>

                                                <!-- PRECIO -->

                                                <Label text="\$2.50"
                                                       style="-fx-font-size: 12px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #D97706;"/>

                                                <!-- CONTROLES DE CANTIDAD -->

                                                <HBox alignment="CENTER"
                                                      spacing="8.0">

                                                    <children>

                                                        <Button text="-"
                                                                prefWidth="30.0"
                                                                prefHeight="25.0"
                                                                style="-fx-background-color: #E9BD6B;
                                                                       -fx-text-fill: #422817;
                                                                       -fx-font-weight: bold;"/>

                                                        <Label text="0"
                                                               style="-fx-font-size: 13px;
                                                                      -fx-font-weight: bold;
                                                                      -fx-text-fill: #422817;"/>

                                                        <Button text="+"
                                                                prefWidth="30.0"
                                                                prefHeight="25.0"
                                                                style="-fx-background-color: #422817;
                                                                       -fx-text-fill: white;
                                                                       -fx-font-weight: bold;"/>

                                                    </children>
                                                </HBox>

                                            </children>
                                        </VBox>

                                        <!-- FIN DE TARJETA DE EJEMPLO -->

                                    </children>
                                </FlowPane>

                            </content>
                        </ScrollPane>

                    </children>
                </VBox>

                <!-- PANEL DERECHO DEL PEDIDO -->

                <VBox prefWidth="350.0"
                      minWidth="350.0"
                      spacing="10.0"
                      style="-fx-background-color: #FFF8EC;
                             -fx-background-radius: 15;
                             -fx-padding: 12;">

                    <children>

                        <!-- TABLA DE PRODUCTOS -->

                        <TableView fx:id="tablaPedido"
                                   prefHeight="310.0"
                                   VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: white;
                                          -fx-border-color: #E9BD6B;
                                          -fx-border-radius: 10;">

                            <columns>

                                <TableColumn fx:id="colProducto"
                                             text="Pan / precio"
                                             prefWidth="160.0"/>

                                <TableColumn fx:id="colCantidad"
                                             text="Cant."
                                             prefWidth="55.0"/>

                                <TableColumn fx:id="colSubtotal"
                                             text="Subtotal"
                                             prefWidth="100.0"/>

                            </columns>
                        </TableView>

                        <!-- TOTAL DEL PEDIDO -->

                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0"
                              prefHeight="48.0"
                              style="-fx-background-color: #FFE5AA;
                                     -fx-background-radius: 10;
                                     -fx-padding: 10;">

                            <children>

                                <Label text="Total:"
                                       style="-fx-font-family: Georgia;
                                              -fx-font-size: 22px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #422817;"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label fx:id="lblTotal"
                                       text="0.00"
                                       style="-fx-font-size: 22px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #422817;"/>

                            </children>
                        </HBox>

                        <HBox spacing="8"><Button fx:id="btnQuitarUno" text="Quitar una pieza"/><Button fx:id="btnVaciarCuenta" text="Vaciar cuenta"/></HBox>
                        <Label text="Forma de pago"/>
                        <ComboBox fx:id="cmbPago" maxWidth="Infinity"/>
                        <TextField fx:id="txtRecibido" promptText="Efectivo recibido"/>
                        <TextField fx:id="txtReferencia" promptText="Referencia de tarjeta / transferencia"/>
                        <Button fx:id="btnDevolucion" text="Devoluciones" maxWidth="Infinity"/>
                        <Button fx:id="btnFinalizar" text="Finalizar venta" onAction="#finalizarVenta" maxWidth="Infinity" prefHeight="42" style="-fx-background-color: #422817; -fx-text-fill: white;"/>
                    </children>
                </VBox>

            </children>
        </HBox>
    </center>

</BorderPane>
