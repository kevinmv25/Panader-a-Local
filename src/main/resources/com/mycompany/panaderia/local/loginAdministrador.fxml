<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: #FAFAFA; -fx-padding: 15;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.panaderia.local.AdminController">
   <!-- Cabecera Superior del Panel de Administrador -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="40.0" style="-fx-background-color: #333333; -fx-padding: 0 15 0 15;" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="PANEL DE ADMINISTRACIÓN · EL LIRIO ROJO" textFill="WHITE" />
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
               <children>
                  <Button fx:id="btnCerrarSesion" mnemonicParsing="false" style="-fx-background-color: #666666; -fx-text-fill: white; -fx-font-size: 10px;" text="Cerrar Sesión" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>

   <center>
      <VBox spacing="8.0" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="HU17 · VISTA DE GESTIÓN Y NEGOCIO" textFill="#666666" />
            
            <!-- Contenedor Principal del Panel -->
            <BorderPane prefHeight="550.0" prefWidth="920.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-width: 1;">
               
               <!-- Menú de Opciones del Administrador (Lateral Izquierdo) -->
               <left>
                  <VBox prefWidth="180.0" spacing="6.0" style="-fx-background-color: #EAEAEA; -fx-padding: 12;" BorderPane.alignment="CENTER">
                     <children>
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 0 5 0;" text="MENÚ GERENCIAL" textFill="#555555" />
                        <Button maxWidth="Infinity" style="-fx-background-color: #777777; -fx-text-fill: white; -fx-font-size: 11px;" text="Resumen del Negocio" />
                        <Button maxWidth="Infinity" style="-fx-background-color: #DDDDDD; -fx-font-size: 11px;" text="Inventario de Panes" />
                        <Button maxWidth="Infinity" style="-fx-background-color: #DDDDDD; -fx-font-size: 11px;" text="Historial de Ventas" />
                        <Button maxWidth="Infinity" style="-fx-background-color: #DDDDDD; -fx-font-size: 11px;" text="Gestión de Empleados" />
                        <Button maxWidth="Infinity" style="-fx-background-color: #DDDDDD; -fx-font-size: 11px;" text="Reportes y Finanzas" />
                     </children>
                  </VBox>
               </left>

               <!-- Área Central con la Información del Negocio -->
               <center>
                  <VBox spacing="12.0" style="-fx-padding: 15;" BorderPane.alignment="CENTER">
                     <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Resumen de Operaciones y Métricas" textFill="#333333" />
                        
                        <!-- Bloque de Tarjetas de Indicadores (KPIs) -->
                        <HBox spacing="15.0">
                           <children>
                              <VBox prefHeight="70.0" prefWidth="220.0" spacing="4.0" style="-fx-background-color: #EFEFEF; -fx-border-color: #DDDDDD; -fx-padding: 10;">
                                 <children>
                                    <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="VENTAS TOTALES DEL DÍA" textFill="#666666" />
                                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="\$3,450.00" textFill="#333333" />
                                 </children>
                              </VBox>
                              <VBox prefHeight="70.0" prefWidth="220.0" spacing="4.0" style="-fx-background-color: #EFEFEF; -fx-border-color: #DDDDDD; -fx-padding: 10;">
                                 <children>
                                    <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="PEDIDOS REGISTRADOS" textFill="#666666" />
                                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="48" textFill="#333333" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <!-- Tabla de Actividad Reciente / Información del Negocio -->
                        <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                           <children>
                              <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Últimas Transacciones del Negocio" textFill="#444444" />
                              <TableView prefHeight="250.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                                <columns>
                                  <TableColumn prefWidth="90.0" text="ID Pedido" />
                                  <TableColumn prefWidth="120.0" text="Hora" />
                                  <TableColumn prefWidth="140.0" text="Cajero" />
                                  <TableColumn prefWidth="130.0" text="Total" />
                                  <TableColumn prefWidth="130.0" text="Estado" />
                                </columns>
                              </TableView>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </center>
            </BorderPane>
         </children>
      </VBox>
   </center>
</BorderPane>
